/*
 * RoadSense_v4_ML.ino  --  v3 + on-device ML event filter (random forest)
 *
 * WHAT v4 ADDS (USE_ML 1)
 *   The trigger is loosened (K_LOCAL 6 -> 2) so far fewer real anomalies are
 *   missed. Every event window is then scored by a 40-tree random forest
 *   (rs_ml_model.h, generated by export_model.py) on 21 features computed from
 *   the same 1.4 s window (rs_ml_features.h). All amplitude features are divided
 *   by this vehicle's ABC calibration, so the model transfers between vehicles.
 *     P(NONE) >= ML_KEEP_PNONE  -> event dropped (still logged as E,...,NONE)
 *     otherwise                 -> BREAKER or POTHOLE/ROUGHBURST from the forest
 *   Extra output line per event:  Q,ms,pBreaker,pNone,pSurface,us
 *   USE_ML 0 gives exactly the v3 behaviour (K_LOCAL 6, rule labels).
 *   Leave-one-vehicle-out result (3 drives): see RESULTS_ML.md.
 *
 * ---- v3 description (unchanged below) ----
 * RoadSense_v3.ino  --  single-pass road anomaly logger + classifier
 * Hardware (unchanged): ESP32 + MPU6050 (I2C SDA=21, SCL=22, addr 0x68)
 *                       + NEO-6M GPS (UART2 RX=16, TX=17, 9600 baud)
 * Optional: push button GPIO4 -> GND for ground-truth tagging.
 * On-board LED (GPIO2): ON while calibrating, short flash each time a tag is logged.
 *
 * WHY v3 (what was wrong in v2)
 *   v2 sampled at 10 Hz and used vibrationDelta = |a(t) - a(t-1)|, i.e. the
 *   CHANGE between two readings. A speed breaker produces a spike going up
 *   and a spike coming down, but the smooth ride over the top is invisible
 *   to a difference signal, so the "time above threshold" was always ~1-2
 *   samples (<300 ms) -> every breaker was labelled POTHOLE, and the 1 s
 *   cooldown hid the second spike.
 *
 * WHAT v3 DOES
 *   1. Samples accel + gyro at 100 Hz (MPU6050 DLPF 44 Hz, +-4 g range).
 *   2. Two signals:
 *        jerk  = |a(t) - a(t-1)|          -> sharp impacts (pothole edges)
 *        heave = low-pass (3 Hz) VERTICAL acceleration of the car body.
 *                "Vertical" is learned from gravity, so mounting
 *                orientation does not matter.
 *   3. An event starts when jerk > mu_j + K_EVENT*sigma_j AND the spike stands
 *      out from the last 1 s of road (jerk > K_LOCAL x 1 s mean), OR when the
 *      body heave alone is very strong (gentle breakers). A fixed analysis
 *      window (0.2 s before .. 1.2 s after) is then measured:
 *        heaveDur = time the body heave stays beyond K_HEAVE*sigma_h
 *      A breaker lifts the whole car -> long heave  -> BREAKER
 *      A pothole is a short sharp hit -> short heave -> POTHOLE
 *      Many separate hits in one window -> ROUGHBURST (rough patch, not a
 *      discrete event).
 *   4. Road roughness tier (GREEN/YELLOW/RED) from the 1 s mean jerk vs its
 *      calibrated baseline, as before.
 *   5. All thresholds are mu + k*sigma (AdaptiveBaseline.h), calibrated per
 *      vehicle and slowly adapted (~30 s time constant) on normal road only.
 *   6. Ground truth: type p / b / r / o in CoolTerm (or press the button:
 *      short = pothole, long >0.6 s = breaker) when you cross an anomaly.
 *   7. RAW 100 Hz data is streamed (R lines) so classification can be
 *      re-tuned offline with roadsense_analyze.py -- no re-drive needed.
 *   8. Events, tags and the 10 Hz summary are ALSO saved to ESP32 flash
 *      (LittleFS) as a backup. Type D to dump, E then Y to erase.
 *
 * SERIAL: 460800 baud (set the same in CoolTerm).
 *
 * OUTPUT LINES
 *   R,ms,ax,ay,az,gx,gy,gz                      raw 100 Hz (int16 counts)
 *   ms,lat,lon,effectiveDelta,LABEL             10 Hz summary (old format;
 *                                               effectiveDelta in milli-g)
 *   E,ms,lat,lon,LABEL,jerkPk_mg,jerkZ,heavePP_mg,heaveZ,heaveDurMs,nHits,hitSpanMs,firstSign
 *   M,ms,lat,lon,LABEL,src                      ground-truth tag
 *   K,ms                                        calibration started
 *   C,ms,mu_j,sig_j,sig_h,mu_r,sig_r,gx,gy,gz   calibration result (g units)
 *   #...                                        info / boot / warnings
 *
 * KEYS (type in CoolTerm)
 *   p pothole tag   b breaker tag   r rough-patch tag   o other tag
 *   c recalibrate (do it while driving on a SMOOTH stretch)
 *   s status        D dump flash log    E then Y erase flash log
 *   x toggle raw stream                 ? help
 */

#include <Wire.h>
#include <TinyGPS++.h>
#include <FS.h>
#include <LittleFS.h>
#include <freertos/stream_buffer.h>
#include "AdaptiveBaseline.h"

#ifndef USE_ML
#define USE_ML 1            // 0 = v3 rules only (the ICEdge 2026 configuration)
#endif
#if USE_ML
#include "rs_ml_features.h"
#include "rs_ml_model.h"
const float ML_KEEP_PNONE = 0.5f;   // keep an event if P(NONE) < this (higher = more recall, more false alarms)
#endif

// ===================== configuration =====================
#define SERIAL_BAUD       460800
#define USE_FLASH_BACKUP  1
#define USE_BUTTON        1
#define BUTTON_PIN        4
#define LED_PIN           2   // on-board blue LED: ON while calibrating, quick flash per tag

#define SDA_PIN 21
#define SCL_PIN 22
#define RXD2    16
#define TXD2    17
const uint8_t MPU = 0x68;

const uint32_t SAMPLE_US     = 10000;   // 100 Hz
const float    DT            = 0.01f;
const float    ACC_LSB_PER_G = 8192.0f; // +-4 g range
const uint32_t GRAV_CALIB_MS = 1500;    // phase A: learn gravity direction
const uint32_t STAT_CALIB_MS = 6500;    // phase B: learn noise statistics

// ---- detection constants (dimensionless k's; tune offline) ----
// Values below: tuned on the fully tagged hatchback drive (3 Oct) and frozen for sedan/SUV.
const float    K_EVENT              = 5.0f;  // jerk trigger (vs calibrated noise)
#if USE_ML
const float    K_LOCAL              = 2.0f;  // loose trigger: the forest removes the extra false alarms
#else
const float    K_LOCAL              = 6.0f;  // jerk must also be > K_LOCAL x local 1 s mean
#endif
                                             // (stops rough patches spamming events; 0 = off)
const float    K_HEAVE_TRIG         = 6.0f;  // strong body heave alone also starts an event
                                             // (gentle breakers give little jerk)
const float    K_HEAVE              = 2.0f;  // heave "active" level
const uint32_t HEAVE_DUR_BREAKER_MS = 450;   // >= this -> BREAKER
const int      ROUGH_BURST_HITS     = 3;     // >= this many hits -> rough patch
const float    K_ROUGH_YELLOW       = 2.5f;
const float    K_ROUGH_RED          = 4.0f;

const uint32_t PRE_MS  = 200;   // analysis window before trigger
const uint32_t POST_MS = 1200;  // analysis window after trigger
const uint32_t HIT_GAP_MS = 60; // jerk excursions closer than this = same hit

const float HEAVE_LP_HZ   = 3.0f;
const float TC_BASELINE_S = 30.0f;
const float TC_GRAVITY_S  = 5.0f;

// ===================== globals =====================
TinyGPSPlus gps;
HardwareSerial gpsSerial(2);

AdaptiveBaseline jb;   // jerk (per sample, g)
AdaptiveBaseline hb;   // heave (per sample, g)
AdaptiveBaseline rb;   // 1 s mean jerk (roughness, g)

enum CalState { CAL_GRAV, CAL_STATS, RUN };
CalState calState = CAL_GRAV;
uint32_t calStartMs = 0;
double   gSum[3]; uint32_t gN = 0;

float gVec[3] = {0, 0, 1};   // gravity vector estimate (g)
float gMag = 1.0f;
float prevA[3] = {0, 0, 0};
bool  havePrev = false;
float heaveLP = 0;
float heaveAlpha;

// 1 s jerk ring for roughness
const int RWIN = 100;
float rRing[RWIN]; int rIdx = 0; int rCount = 0; double rSum = 0;

// pre-trigger ring
const int PRE_N = PRE_MS / 10;
struct PreS { uint32_t ms; float jerk; float heave; float av; float ah; };
PreS preRing[PRE_N]; int preIdx = 0; int preCount = 0;

// event state
bool     evActive = false;
uint32_t evT0 = 0;
double   evLat = 0, evLon = 0;
float    evTj = 0, evThH = 0;
float    evJerkPk = 0, evHMax = -1e9, evHMin = 1e9;
uint32_t evHeaveSamples = 0;
int      evHits = 0;
bool     evAbove = false;
uint32_t evLastAboveMs = 0, evFirstHitMs = 0, evLastHitMs = 0;
int      evFirstSign = 0;
const char* pendingEventLabel = nullptr;
#if USE_ML
RsmlWin  evWin;                 // samples of the current event window (for the ML features)
RsmlCal  evCal;                 // calibration snapshot at the trigger
uint32_t mlDropped = 0, mlLastUs = 0, mlMaxUs = 0;
#endif

uint32_t nextSampleUs = 0;
uint32_t lastSummaryMs = 0;
const char* currentTier = "GREEN";
bool rawStream = true;

int  i2cErrStreak = 0;
uint32_t lastI2cMsgMs = 0;
uint32_t potholes = 0, breakers = 0, roughBursts = 0, marks = 0;

// flash
#if USE_FLASH_BACKUP
// Flash writes run in a separate task on core 0 so they never stall the
// 100 Hz sampling loop (v3.0 lost 40-110 ms every 2 s on each flush).
File logFile;
volatile bool flashOk = false, flashFull = false;
uint32_t eraseArmMs = 0;
StreamBufferHandle_t flashQ = nullptr;
SemaphoreHandle_t fileMutex = nullptr;
volatile uint32_t flashDropped = 0;
#endif

// button
#if USE_BUTTON
bool btnDown = false; uint32_t btnDownMs = 0, btnChangeMs = 0;
#endif

char line[200];
uint32_t ledOffAt = 0;

void noteI2cErr(int code);   // forward declaration

// ===================== helpers =====================
void out(const char* s, bool toFlash) {
  Serial.println(s);
#if USE_FLASH_BACKUP
  if (toFlash && flashOk && !flashFull && flashQ) {
    size_t n = strlen(s);
    if (xStreamBufferSpacesAvailable(flashQ) >= n + 1) {   // whole line or nothing
      xStreamBufferSend(flashQ, s, n, 0);
      xStreamBufferSend(flashQ, "\n", 1, 0);
    } else {
      flashDropped++;
    }
  }
#endif
}

#if USE_FLASH_BACKUP
void flashTask(void*) {
  static uint8_t buf[512];
  uint32_t lastFlush = millis();
  for (;;) {
    size_t n = xStreamBufferReceive(flashQ, buf, sizeof buf, pdMS_TO_TICKS(200));
    bool flushDue = millis() - lastFlush > 30000;   // ESP32 pauses BOTH cores ~35 ms per flash commit,
                                                     // so commit rarely (power cut loses <=30 s of BACKUP only)
    if (n == 0 && !flushDue) continue;
    xSemaphoreTake(fileMutex, portMAX_DELAY);
    if (n && !flashFull) logFile.write(buf, n);
    if (flushDue) {
      logFile.flush(); lastFlush = millis();
      if (!flashFull && LittleFS.totalBytes() - LittleFS.usedBytes() < 16384) {
        flashFull = true;
        Serial.println("#WARN flash backup full - flash logging stopped (Serial still OK)");
      }
    }
    xSemaphoreGive(fileMutex);
  }
}
#endif

void curLatLon(double& lat, double& lon) {
  if (gps.location.isValid() && gps.location.age() < 3000) {
    lat = gps.location.lat(); lon = gps.location.lng();
  } else { lat = 0; lon = 0; }
}

uint8_t mpuWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU); Wire.write(reg); Wire.write(val);
  return Wire.endTransmission(true);
}

uint8_t mpuInit() {
  uint8_t e = 0;
  e |= mpuWrite(0x6B, 0x01);  // wake, PLL with X gyro clock
  delay(10);
  e |= mpuWrite(0x19, 9);     // sample rate = 1 kHz / (1+9) = 100 Hz
  e |= mpuWrite(0x1A, 3);     // DLPF ~44 Hz
  e |= mpuWrite(0x1B, 0x08);  // gyro +-500 dps
  e |= mpuWrite(0x1C, 0x08);  // accel +-4 g
  return e;
}

bool mpuRead(int16_t* v) {   // ax ay az gx gy gz
  Wire.beginTransmission(MPU); Wire.write(0x3B);
  uint8_t e = Wire.endTransmission(true);       // full stop (no repeated start)
  if (e != 0) { noteI2cErr(e); return false; }
  uint8_t got = Wire.requestFrom(MPU, (uint8_t)14, (uint8_t)true);
  if (got < 14) { while (Wire.available()) Wire.read(); noteI2cErr(100 + got); return false; }
  uint8_t b[14];
  for (int i = 0; i < 14; i++) b[i] = Wire.read();
  v[0] = (int16_t)(b[0] << 8 | b[1]);  v[1] = (int16_t)(b[2] << 8 | b[3]);
  v[2] = (int16_t)(b[4] << 8 | b[5]);
  v[3] = (int16_t)(b[8] << 8 | b[9]);  v[4] = (int16_t)(b[10] << 8 | b[11]);
  v[5] = (int16_t)(b[12] << 8 | b[13]);
  i2cErrStreak = 0;
  return true;
}

void noteI2cErr(int code) {
  i2cErrStreak++;
  if (millis() - lastI2cMsgMs > 1000) {
    snprintf(line, sizeof line, "#I2C_ERR code=%d streak=%d", code, i2cErrStreak);
    Serial.println(line); lastI2cMsgMs = millis();
  }
  if (i2cErrStreak == 20) {        // try to recover the bus
    Wire.end(); delay(5);
    Wire.begin(SDA_PIN, SCL_PIN); Wire.setClock(100000);
    mpuInit();
    Serial.println("#I2C bus re-initialised");
  }
}

void startCalibration() {
  calState = CAL_GRAV; calStartMs = millis();
  gSum[0] = gSum[1] = gSum[2] = 0; gN = 0;
  jb.beginCalib(); hb.beginCalib(); rb.beginCalib();
  evActive = false;
  snprintf(line, sizeof line, "K,%lu", (unsigned long)calStartMs);
  out(line, true);
  Serial.println("#CALIBRATING 8 s - drive normally on a SMOOTH stretch (or stay still)");
  digitalWrite(LED_PIN, HIGH); ledOffAt = 0;   // LED stays on until calibration completes
}

void addMark(const char* label, const char* src) {
  double lat, lon; curLatLon(lat, lon);
  snprintf(line, sizeof line, "M,%lu,%.6f,%.6f,%s,%s", (unsigned long)millis(), lat, lon, label, src);
  out(line, true); marks++;
  digitalWrite(LED_PIN, HIGH); ledOffAt = millis() + 250;   // visible confirmation
}

void printStatus() {
  snprintf(line, sizeof line, "#STATUS cal=%d mu_j=%.4f sig_j=%.4f sig_h=%.4f mu_r=%.4f sig_r=%.4f sats=%lu fix=%d P=%lu B=%lu RB=%lu marks=%lu",
           (int)calState, jb.getMu(), jb.getSigma(), hb.getSigma(), rb.getMu(), rb.getSigma(),
           (unsigned long)gps.satellites.value(), (int)gps.location.isValid(),
           (unsigned long)potholes, (unsigned long)breakers, (unsigned long)roughBursts, (unsigned long)marks);
  Serial.println(line);
#if USE_ML
  snprintf(line, sizeof line, "#ML forest %d trees, dropped=%lu, last=%lu us, max=%lu us",
           RSML_NTREES, (unsigned long)mlDropped, (unsigned long)mlLastUs, (unsigned long)mlMaxUs);
  Serial.println(line);
#endif
#if USE_FLASH_BACKUP
  snprintf(line, sizeof line, "#FLASH ok=%d full=%d used=%lu/%lu bytes dropped_lines=%lu", (int)flashOk, (int)flashFull,
           (unsigned long)LittleFS.usedBytes(), (unsigned long)LittleFS.totalBytes(), (unsigned long)flashDropped);
  Serial.println(line);
#endif
}

void printHelp() {
  Serial.println("#KEYS p=pothole b=breaker r=rough o=other | c=recalibrate s=status x=raw on/off | D=dump flash  E then Y=erase flash");
}

#if USE_FLASH_BACKUP
void dumpFlash() {
  vTaskDelay(pdMS_TO_TICKS(300));            // let the writer drain its queue
  xSemaphoreTake(fileMutex, portMAX_DELAY);
  logFile.flush(); logFile.close();
  File f = LittleFS.open("/drive.csv", "r");
  Serial.println("#DUMP_BEGIN");
  if (f) {
    uint8_t buf[256];
    while (f.available()) { int n = f.read(buf, sizeof buf); Serial.write(buf, n); }
    f.close();
  }
  Serial.println("#DUMP_END");
  logFile = LittleFS.open("/drive.csv", "a");
  xSemaphoreGive(fileMutex);
  nextSampleUs = micros();
}
#endif

void handleKeys() {
  while (Serial.available()) {
    char ch = Serial.read();
    switch (ch) {
      case 'p': addMark("POTHOLE", "key"); break;
      case 'b': addMark("BREAKER", "key"); break;
      case 'r': addMark("ROUGH", "key"); break;
      case 'o': addMark("OTHER", "key"); break;
      case 'c': startCalibration(); break;
      case 's': printStatus(); break;
      case 'x': rawStream = !rawStream; Serial.println(rawStream ? "#RAW on" : "#RAW off"); break;
      case '?': printHelp(); break;
#if USE_FLASH_BACKUP
      case 'D': if (flashOk && fileMutex) dumpFlash(); break;
      case 'E': eraseArmMs = millis(); Serial.println("#ERASE flash log? type Y within 5 s"); break;
      case 'Y':
        if (eraseArmMs && millis() - eraseArmMs < 5000 && flashOk) {
          xSemaphoreTake(fileMutex, portMAX_DELAY);
          logFile.close(); LittleFS.remove("/drive.csv");
          logFile = LittleFS.open("/drive.csv", "a"); flashFull = false;
          xSemaphoreGive(fileMutex);
          Serial.println("#ERASED");
        }
        eraseArmMs = 0; break;
#endif
      default: break;
    }
  }
}

#if USE_BUTTON
void handleButton() {
  bool down = digitalRead(BUTTON_PIN) == LOW;
  uint32_t now = millis();
  if (down != btnDown && now - btnChangeMs > 30) {   // debounce
    btnChangeMs = now;
    btnDown = down;
    if (down) btnDownMs = now;
    else addMark((now - btnDownMs) > 600 ? "BREAKER" : "POTHOLE", "btn");
  }
}
#endif

// ---- event feature accumulation ----
void evFeed(uint32_t ms, float jerk, float heave) {
  if (jerk > evJerkPk) evJerkPk = jerk;
  if (heave > evHMax) evHMax = heave;
  if (heave < evHMin) evHMin = heave;
  float hd = heave - hb.getMu();
  if (fabsf(hd) > evThH) {
    evHeaveSamples++;
    if (evFirstSign == 0) evFirstSign = hd > 0 ? 1 : -1;
  }
  bool above = jerk > evTj;
  if (above) {
    if (!evAbove && (evHits == 0 || ms - evLastAboveMs > HIT_GAP_MS)) {
      evHits++;
      if (evHits == 1) evFirstHitMs = ms;
      evLastHitMs = ms;
    }
    evLastAboveMs = ms;
  }
  evAbove = above;
}

void evStart(uint32_t ms, float m1s) {
  evActive = true; evT0 = ms;
#if USE_ML
  evCal = { jb.getMu(), jb.getSigma(), hb.getMu(), hb.getSigma(), rb.getMu(), rb.getSigma(), m1s };
  rsml_reset(evWin, ms);
#else
  (void)m1s;
#endif
  curLatLon(evLat, evLon);
  evTj = jb.threshold(K_EVENT);
  evThH = K_HEAVE * hb.getSigma();
  evJerkPk = 0; evHMax = -1e9; evHMin = 1e9; evHeaveSamples = 0;
  evHits = 0; evAbove = false; evLastAboveMs = 0; evFirstSign = 0;
  int n = preCount, start = (preIdx - preCount + PRE_N) % PRE_N;
  for (int i = 0; i < n; i++) {
    PreS& p = preRing[(start + i) % PRE_N];
    evFeed(p.ms, p.jerk, p.heave);
#if USE_ML
    rsml_push(evWin, p.ms, p.jerk, p.heave, p.av, p.ah);
#endif
  }
}

void evFinish() {
  evActive = false;
  uint32_t heaveDur = evHeaveSamples * 10;
  const char* label;
#if USE_ML
  float feat[RSML_NFEAT], pr[RSML_NCLASS];
  uint32_t t0us = micros();
  rsml_features(evWin, evCal, (float)heaveDur, evHits, (float)(evLastHitMs - evFirstHitMs), evFirstSign, feat);
  rsml_predict(feat, pr);
  mlLastUs = micros() - t0us; if (mlLastUs > mlMaxUs) mlMaxUs = mlLastUs;
  if (pr[RSML_CLASS_NONE] >= ML_KEEP_PNONE)                 { label = "NONE"; mlDropped++; }
  else if (pr[RSML_CLASS_BREAKER] >= pr[RSML_CLASS_SURFACE]) { label = "BREAKER"; breakers++; }
  else if (evHits >= ROUGH_BURST_HITS)                      { label = "ROUGHBURST"; roughBursts++; }
  else                                                      { label = "POTHOLE"; potholes++; }
#else
  if (evHits >= ROUGH_BURST_HITS)              { label = "ROUGHBURST"; roughBursts++; }
  else if (heaveDur >= HEAVE_DUR_BREAKER_MS)   { label = "BREAKER";    breakers++; }
  else                                         { label = "POTHOLE";    potholes++; }
#endif
  float heavePP = evHMax - evHMin;
  snprintf(line, sizeof line, "E,%lu,%.6f,%.6f,%s,%.1f,%.2f,%.1f,%.2f,%lu,%d,%lu,%d",
           (unsigned long)evT0, evLat, evLon, label,
           evJerkPk * 1000.0f, jb.z(evJerkPk),
           heavePP * 1000.0f, hb.getSigma() > 0 ? heavePP / hb.getSigma() : 0,
           (unsigned long)heaveDur, evHits, (unsigned long)(evLastHitMs - evFirstHitMs), evFirstSign);
  out(line, true);
#if USE_ML
  snprintf(line, sizeof line, "Q,%lu,%.3f,%.3f,%.3f,%lu", (unsigned long)evT0,
           pr[RSML_CLASS_BREAKER], pr[RSML_CLASS_NONE], pr[RSML_CLASS_SURFACE], (unsigned long)mlLastUs);
  out(line, true);
  if (strcmp(label, "NONE") == 0) return;      // dropped by the forest: not on the map
#endif
  if (strcmp(label, "ROUGHBURST") != 0) pendingEventLabel = label;
}

// ===================== setup / loop =====================
void setup() {
  Serial.setTxBufferSize(8192);
  Serial.begin(SERIAL_BAUD);
  delay(300);
  Serial.println(USE_ML ? "#BOOT RoadSense v4 (ML filter ON)" : "#BOOT RoadSense v4 (ML off = v3)");

  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(100000);
  delay(100);
  uint8_t e = mpuInit();
  Wire.beginTransmission(MPU); Wire.write(0x75); Wire.endTransmission(true);
  Wire.requestFrom(MPU, (uint8_t)1, (uint8_t)true);
  int who = Wire.available() ? Wire.read() : -1;
  snprintf(line, sizeof line, "#MPU init err=%u WHO_AM_I=0x%02X (0x68 expected; clones may differ)", e, who & 0xFF);
  Serial.println(line);

  gpsSerial.begin(9600, SERIAL_8N1, RXD2, TXD2);

#if USE_BUTTON
  pinMode(BUTTON_PIN, INPUT_PULLUP);
#endif
  pinMode(LED_PIN, OUTPUT); digitalWrite(LED_PIN, LOW);

#if USE_FLASH_BACKUP
  flashOk = LittleFS.begin(true);
  if (flashOk) {
    logFile = LittleFS.open("/drive.csv", "a");
    flashOk = (bool)logFile;
  }
  Serial.println(flashOk ? "#FLASH backup ON (/drive.csv)" : "#WARN flash backup unavailable");
  if (flashOk) {
    logFile.println("#BOOT RoadSense v4");
    flashQ = xStreamBufferCreate(16384, 1);
    fileMutex = xSemaphoreCreateMutex();
    xTaskCreatePinnedToCore(flashTask, "flashlog", 4096, nullptr, 1, nullptr, 0);
  }
#endif

  heaveAlpha = DT / (1.0f / (2.0f * PI * HEAVE_LP_HZ) + DT);
  printHelp();
  startCalibration();
  nextSampleUs = micros();
}

void loop() {
  while (gpsSerial.available()) gps.encode(gpsSerial.read());
  handleKeys();
  if (ledOffAt && (int32_t)(millis() - ledOffAt) >= 0) { digitalWrite(LED_PIN, LOW); ledOffAt = 0; }
#if USE_BUTTON
  handleButton();
#endif
  // ---- fixed 100 Hz schedule ----
  uint32_t nowUs = micros();
  if ((int32_t)(nowUs - nextSampleUs) < 0) return;
  nextSampleUs += SAMPLE_US;
  if ((int32_t)(nowUs - nextSampleUs) > 20000) nextSampleUs = nowUs + SAMPLE_US;  // fell behind: resync, don't burst

  int16_t v[6];
  if (!mpuRead(v)) return;
  uint32_t ms = millis();

  if (rawStream) {
    snprintf(line, sizeof line, "R,%lu,%d,%d,%d,%d,%d,%d", (unsigned long)ms, v[0], v[1], v[2], v[3], v[4], v[5]);
    Serial.println(line);
  }

  float a[3] = { v[0] / ACC_LSB_PER_G, v[1] / ACC_LSB_PER_G, v[2] / ACC_LSB_PER_G };

  // ---- jerk ----
  float jerk = 0;
  if (havePrev) {
    float dx = a[0] - prevA[0], dy = a[1] - prevA[1], dz = a[2] - prevA[2];
    jerk = sqrtf(dx * dx + dy * dy + dz * dz);
  }
  prevA[0] = a[0]; prevA[1] = a[1]; prevA[2] = a[2]; havePrev = true;

  // ---- phase A: gravity direction ----
  if (calState == CAL_GRAV) {
    gSum[0] += a[0]; gSum[1] += a[1]; gSum[2] += a[2]; gN++;
    if (ms - calStartMs >= GRAV_CALIB_MS && gN > 10) {
      for (int i = 0; i < 3; i++) gVec[i] = gSum[i] / gN;
      gMag = sqrtf(gVec[0] * gVec[0] + gVec[1] * gVec[1] + gVec[2] * gVec[2]);
      heaveLP = 0; rIdx = 0; rCount = 0; rSum = 0; preCount = 0;
      calState = CAL_STATS;
    }
    return;
  }

  // ---- heave: low-passed vertical acceleration ----
  float gm = sqrtf(gVec[0] * gVec[0] + gVec[1] * gVec[1] + gVec[2] * gVec[2]);
  float proj = (a[0] * gVec[0] + a[1] * gVec[1] + a[2] * gVec[2]) / gm;
  float av = proj - gm;                                         // vertical accel (g, gravity removed)
  float ah2 = a[0] * a[0] + a[1] * a[1] + a[2] * a[2] - proj * proj;
  float ah = ah2 > 0 ? sqrtf(ah2) : 0;                          // horizontal accel magnitude (g)
  heaveLP += heaveAlpha * (av - heaveLP);
  float heave = heaveLP;

  // ---- 1 s roughness window ----
  if (rCount == RWIN) rSum -= rRing[rIdx]; else rCount++;
  rRing[rIdx] = jerk; rSum += jerk; rIdx = (rIdx + 1) % RWIN;
  float m1s = rSum / rCount;

  // ---- phase B: noise statistics ----
  if (calState == CAL_STATS) {
    jb.addCalib(jerk); hb.addCalib(heave);
    if (rCount == RWIN && (ms % 100) < 10) rb.addCalib(m1s);
    if (ms - calStartMs >= GRAV_CALIB_MS + STAT_CALIB_MS) {
      jb.finishCalib(0.002f, 0.15f);
      hb.finishCalib(0.003f, 0.0f);
      if (!rb.finishCalib(0.001f, 0.10f)) { rb.addCalib(m1s); rb.addCalib(m1s); rb.finishCalib(0.001f, 0.10f); }
      calState = RUN;
      snprintf(line, sizeof line, "C,%lu,%.5f,%.5f,%.5f,%.5f,%.5f,%.4f,%.4f,%.4f", (unsigned long)ms,
               jb.getMu(), jb.getSigma(), hb.getSigma(), rb.getMu(), rb.getSigma(), gVec[0], gVec[1], gVec[2]);
      out(line, true);
      Serial.println("#CALIBRATION COMPLETE - detecting");
      digitalWrite(LED_PIN, LOW);
    }
    preRing[preIdx] = { ms, jerk, heave, av, ah }; preIdx = (preIdx + 1) % PRE_N; if (preCount < PRE_N) preCount++;
    return;
  }

  // ---- RUN: discrete events ----
  if (!evActive) {
    bool jerkTrig  = jerk > jb.threshold(K_EVENT) && jerk > K_LOCAL * m1s;
    bool heaveTrig = fabsf(heave - hb.getMu()) > K_HEAVE_TRIG * hb.getSigma();
    if (jerkTrig || heaveTrig) evStart(ms, m1s);
  }
  if (evActive) {
    evFeed(ms, jerk, heave);
#if USE_ML
    rsml_push(evWin, ms, jerk, heave, av, ah);
#endif
    if (ms - evT0 >= POST_MS) evFinish();
  }
  preRing[preIdx] = { ms, jerk, heave, av, ah }; preIdx = (preIdx + 1) % PRE_N; if (preCount < PRE_N) preCount++;

  // ---- roughness tier ----
  if (m1s < rb.threshold(K_ROUGH_YELLOW))   currentTier = "GREEN";
  else if (m1s < rb.threshold(K_ROUGH_RED)) currentTier = "YELLOW";
  else                                      currentTier = "RED";

  // ---- slow adaptation on normal road only ----
  bool normal = !evActive && currentTier[0] == 'G';
  if (normal) {
    const float aS = DT / TC_BASELINE_S;
    jb.adapt(jerk, aS); hb.adapt(heave, aS);
  }
  if (!evActive) {
    const float aG = DT / TC_GRAVITY_S;
    for (int i = 0; i < 3; i++) gVec[i] += aG * (a[i] - gVec[i]);
  }

  // ---- 10 Hz summary row (old CSV format) ----
  if (ms - lastSummaryMs >= 100) {
    lastSummaryMs = ms;
    if (normal) rb.adapt(m1s, 0.1f / TC_BASELINE_S);
    double lat, lon; curLatLon(lat, lon);
    float eff = (m1s - rb.getMu()) * 1000.0f; if (eff < 0) eff = 0;
    const char* label = pendingEventLabel ? pendingEventLabel : currentTier;
    pendingEventLabel = nullptr;
    snprintf(line, sizeof line, "%lu,%.6f,%.6f,%.2f,%s", (unsigned long)ms, lat, lon, eff, label);
    out(line, true);
  }
}
